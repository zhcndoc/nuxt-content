FROM node:24-bookworm AS builder

WORKDIR /app

ENV CI=true

RUN corepack enable pnpm

COPY . .

RUN pnpm install --frozen-lockfile

RUN pnpm exec nuxt-module-build prepare

RUN pnpm run docs:build

FROM node:24-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production \
    NITRO_HOST=0.0.0.0 \
    PORT=8080

COPY --from=builder /app/docs/.output ./docs/.output

COPY --from=builder /app/node_modules/.pnpm/@libsql+linux-*-gnu@*/node_modules/@libsql/ ./docs/.output/server/node_modules/@libsql/

COPY --from=builder /app/docs/.data/db ./docs/.data/db

EXPOSE 8080

CMD ["node", "docs/.output/server/index.mjs"]
